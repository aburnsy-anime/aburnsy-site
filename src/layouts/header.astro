---
const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <div class="container nav-wrap">

        <a class="brand" href="/">
            <img
                src="/images/branding/favicon.png"
                alt="Aburnsy Logo"
                class="brand-logo"
            />

            <span>ABURNSY</span>
        </a>

        <nav class="main-nav" aria-label="Primary navigation">

            <a
                href="/watch/"
                class={currentPath.startsWith("/watch") ? "active" : ""}
            >
                Watch
            </a>

            <a
                href="/about/"
                class={currentPath.startsWith("/about") ? "active" : ""}
            >
                About
            </a>

            <a
                href="/work-with-burnsy/"
                class={currentPath.startsWith("/work-with-burnsy") ? "active" : ""}
            >
                Work With Burnsy
            </a>

            <a
                href="/contact/"
                class={currentPath.startsWith("/contact") ? "active" : ""}
            >
                Contact
            </a>

        </nav>

        <a
            class="button button-small"
            href="https://www.youtube.com/@aburnsy"
            target="_blank"
            rel="noreferrer"
        >
            YouTube
        </a>

        <style>
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-logo {
    width: 34px;
    height: 34px;
    max-width: 34px;
    max-height: 34px;
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>

    </div>
</header>
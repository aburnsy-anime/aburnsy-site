                />

                <span>ABURNSY</span>
            </a>

            <p>Helping You Discover the Best of Anime.</p>

            <p class="footer-small">
                Anime Educator • Creator • Reviewer • Interviewer
            </p>

        </div>

        <div>

            <h3>Explore</h3>

            <a href="/watch/">Watch</a>

            <a href="/about/">About</a>

            <a href="/work-with-burnsy/">Work With Burnsy</a>

            <a href="/contact/">Contact</a>

        </div>

        <div>

            <h3>Community</h3>

            <a href={socialLinks.youtube}>YouTube</a>

            <a href={socialLinks.tiktok}>TikTok</a>

            <a href={socialLinks.instagram}>Instagram</a>

            <a href={socialLinks.patreon}>Patreon</a>

        </div>

        <div>

            <h3>Business</h3>

            <a href="mailto:manager@aburnsy.com">
                manager@aburnsy.com
            </a>

            <a href="mailto:press@aburnsy.com">
                press@aburnsy.com
            </a>

            <a href="mailto:partnerships@aburnsy.com">

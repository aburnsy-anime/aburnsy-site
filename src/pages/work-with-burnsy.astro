---
import Layout from "../layouts/layout.astro";

const socialLinks = {
  youtube: "https://www.youtube.com/@aburnsy",
  tiktok: "https://www.tiktok.com/@aburnsy",
  instagram: "https://www.instagram.com/aburnsy_/",
  patreon: "https://www.patreon.com/Aburnsy",
};
---

<Layout
  title="Work With Burnsy | Partnerships, Press & Appearances"
  description="Partner with Aburnsy for sponsorships, conventions, speaking engagements, interviews, podcasts, and brand collaborations."
>
      <section class="business-hero">
        <div class="container business-hero-grid">
          <div>
            <p class="eyebrow">Partnerships • Press • Appearances</p>

            <h1>Let’s Build Something Meaningful Together.</h1>

            <p class="business-hero-lead">
              Aburnsy works with brands, publishers, conventions, media outlets,
              artists, and creators to produce authentic content that connects
              with anime fans.
            </p>

            <p class="business-hero-copy">
              Every opportunity is approached with professionalism, thoughtful
              planning, and a focus on creating something valuable for both the
              audience and the partner.
            </p>

            <div class="hero-actions">
              <a
                class="button"
                href="mailto:partnerships@aburnsy.com"
              >
                Contact Partnerships
              </a>

              <a class="button button-secondary" href="/contact/">
                Contact the Team
              </a>
            </div>
          </div>

          <div class="business-hero-image">
            <img
              src="/images/burnsy-work.jpg"
              alt="Aburnsy professional creator portrait"
            />
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Audience Snapshot</p>
            <h2>A Trusted Voice in the Anime Community.</h2>
            <p>
              Aburnsy combines audience reach with the perspective of an
              educator, creator, reviewer, and interviewer.
            </p>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <strong>200K+</strong>
              <span>Community Across Platforms</span>
            </div>

            <div class="stat-card">
              <strong>Anime</strong>
              <span>Primary Content Focus</span>
            </div>

            <div class="stat-card">
              <strong>YouTube</strong>
              <span>Long-Form Content and Reactions</span>
            </div>

            <div class="stat-card">
              <strong>Educator</strong>
              <span>Teacher-Led Perspective</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Ways to Collaborate</p>
            <h2>Opportunities Built Around Authentic Connection.</h2>
            <p>
              Partnerships can be customized around campaign goals, audience,
              platform, and format.
            </p>
          </div>

          <div class="partnership-grid">
            <article class="partnership-card">
              <span class="card-number">01</span>
              <h3>Sponsored Content</h3>
              <p>
                Authentic integrations, dedicated videos, short-form campaigns,
                reviews, product features, and creator-led storytelling.
              </p>
            </article>

            <article class="partnership-card">
              <span class="card-number">02</span>
              <h3>Convention Appearances</h3>
              <p>
                Panels, hosting, moderation, meet-and-greets, guest appearances,
                interviews, and community events.
              </p>
            </article>

            <article class="partnership-card">
              <span class="card-number">03</span>
              <h3>Interviews and Podcasts</h3>
              <p>
                Conversations with artists, musicians, creators, voice talent,
                industry professionals, and media outlets.
              </p>
            </article>

            <article class="partnership-card">
              <span class="card-number">04</span>
              <h3>Press and Commentary</h3>
              <p>
                Interviews, expert commentary, anime discussion, creator
                perspectives, and media appearances.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Why Aburnsy</p>
            <h2>A Professional Partner With a Genuine Audience Connection.</h2>
          </div>

          <div class="value-grid">
            <article class="value-card">
              <h3>Authentic</h3>
              <p>
                Recommendations and collaborations are selected with the
                audience’s trust in mind.
              </p>
            </article>

            <article class="value-card">
              <h3>Thoughtful</h3>
              <p>
                Content goes beyond surface-level promotion by connecting
                products and projects to stories, interests, and communities.
              </p>
            </article>

            <article class="value-card">
              <h3>Professional</h3>
              <p>
                Clear communication, organized planning, dependable delivery,
                and a collaborative approach from start to finish.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container industry-grid">
          <div>
            <p class="eyebrow">Ideal Opportunities</p>
            <h2>Built for Anime, Entertainment, and Culture.</h2>

            <p class="industry-copy">
              Aburnsy is especially well suited for partnerships that connect
              naturally with anime fans and adjacent communities.
            </p>
          </div>

          <div class="industry-list">
            <span>Anime and Manga Publishers</span>
            <span>Streaming Platforms</span>
            <span>Gaming Companies</span>
            <span>Conventions and Events</span>
            <span>Music and Entertainment</span>
            <span>Apparel and Merchandise</span>
            <span>Technology and Creator Tools</span>
            <span>Travel and Lifestyle</span>
          </div>
        </div>
      </section>

      <section class="section business-contact-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Contact the Team</p>
            <h2>Start the Conversation.</h2>
            <p>
              Choose the address that best matches your request. Messages are
              reviewed by the Aburnsy management team.
            </p>
          </div>

          <div class="contact-card-grid">
            <a
              class="contact-card"
              href="mailto:partnerships@aburnsy.com"
            >
              <span>Partnerships</span>
              <strong>partnerships@aburnsy.com</strong>
              <p>
                Sponsorships, campaigns, collaborations, and brand
                opportunities.
              </p>
            </a>

            <a class="contact-card" href="mailto:press@aburnsy.com">
              <span>Press</span>
              <strong>press@aburnsy.com</strong>
              <p>
                Interviews, media requests, commentary, and press opportunities.
              </p>
            </a>

            <a class="contact-card" href="mailto:manager@aburnsy.com">
              <span>Management</span>
              <strong>manager@aburnsy.com</strong>
              <p>
                Convention appearances, speaking, bookings, and general
                professional inquiries.
              </p>
            </a>
          </div>

          <p class="business-closing">
            Every successful partnership begins with a conversation. If Aburnsy
            is a strong fit for your project, we’d be glad to hear from you.
          </p>
        </div>
      </section>
   </Layout>
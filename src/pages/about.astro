---
import Layout from "../layouts/layout.astro";

const socialLinks = {
  youtube: "https://www.youtube.com/@aburnsy",
  tiktok: "https://www.tiktok.com/@aburnsy",
  instagram: "https://www.instagram.com/aburnsy_/",
  snapchat: "https://www.snapchat.com/@aburnsy08",
  patreon: "https://www.patreon.com/Aburnsy",
  famousBirthdays: "https://www.famousbirthdays.com/people/aburnsy.html",
};
---

<Layout
  title="About Burnsy | Anime Educator, Creator & Reviewer"
  description="Meet Adam 'Burnsy' Burns, a high school teacher, anime educator, creator, reviewer, interviewer, and lifelong anime fan."
>
      <section class="about-hero">
        <div class="container about-hero-grid">
          <div class="about-hero-copy">
            <p class="eyebrow">About Burnsy</p>

            <h1>More Than Just Anime Reactions.</h1>

            <p class="about-intro">
              I’m Adam “Burnsy” Burns—an anime educator, creator, reviewer, and
              interviewer who believes great stories deserve great
              conversations.
            </p>

            <div class="hero-actions">
              <a
                class="button"
                href={socialLinks.youtube}
                target="_blank"
                rel="noreferrer"
              >
                Watch on YouTube
              </a>

              <a class="button button-secondary" href="/work-with-burnsy/">
                Work With Burnsy
              </a>
            </div>
          </div>

          <div class="about-hero-image">
            <img
              src="/images/burnsy-about.jpg"
              alt="Adam Burnsy Burns standing in front of a manga artwork wall"
            />
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container story-grid">
          <div>
            <p class="eyebrow">My Story</p>
            <h2>Teacher by Day. Creator by Passion.</h2>
          </div>

          <div class="story-copy">
            <p>Hi, I’m Adam “Burnsy” Burns.</p>

            <p>
              By day, I’m a high school computer science teacher and soccer
              coach. Outside the classroom, I’m an anime creator driven by a
              simple belief: great stories deserve great conversations.
            </p>

            <p>
              What started as fun little videos has grown into
              something much bigger—a community of anime fans who love
              discovering incredible series, discussing memorable characters,
              and exploring the storytelling that makes anime such a powerful
              medium.
            </p>

            <p>
              Whether I’m reacting to a new episode, reviewing a hidden gem,
              interviewing creators, or breaking down storytelling in Burnsy’s
              Anime Classroom, my goal is always the same:
            </p>

            <p class="story-emphasis">
              Help more people discover anime they’ll never forget.
            </p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container mission-grid">
          <div class="mission-card">
            <p class="eyebrow">My Mission</p>
            <h2>Make Anime More Approachable and More Meaningful.</h2>

            <p>
              I want to make anime more approachable for new fans while giving
              longtime fans a place where thoughtful conversations matter just
              as much as exciting reactions.
            </p>
          </div>

          <div class="mission-quote">
            <p>
              “The best anime does more than entertain us. It gives us
              characters, ideas, and moments that stay with us.”
            </p>
            <span>— Burnsy</span>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">What I Create</p>
            <h2>Thoughtful Content for Every Kind of Anime Fan.</h2>
            <p>
              From genuine first-time reactions to interviews and educational
              breakdowns, every format begins with the same thing: a love of
              great storytelling.
            </p>
          </div>

          <div class="card-grid">
            <article class="feature-card">
              <span class="card-number">01</span>
              <h3>First-Time Reactions</h3>
              <p>
                Genuine reactions to unforgettable stories, followed by honest
                discussion and analysis.
              </p>
            </article>

            <article class="feature-card">
              <span class="card-number">02</span>
              <h3>Honest Reviews</h3>
              <p>
                Thoughtful, accessible reviews that help fans decide what
                deserves their time.
              </p>
            </article>

            <article class="feature-card">
              <span class="card-number">03</span>
              <h3>Anime Classroom</h3>
              <p>
                Story-focused lessons exploring characters, themes, and why
                great anime works.
              </p>
            </article>

            <article class="feature-card">
              <span class="card-number">04</span>
              <h3>Interviews</h3>
              <p>
                Conversations with creators, musicians, artists, and people
                whose work connects with anime and pop culture.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Beyond the Camera</p>
            <h2>A Few Things About Me.</h2>
          </div>

          <div class="facts-grid">
            <div class="fact-card">
              <span>01</span>
              <p>Based in Texas</p>
            </div>

            <div class="fact-card">
              <span>02</span>
              <p>High school computer science teacher</p>
            </div>

            <div class="fact-card">
              <span>03</span>
              <p>Soccer coach and player</p>
            </div>

            <div class="fact-card">
              <span>04</span>
              <p>Anime creator and interviewer</p>
            </div>

            <div class="fact-card">
              <span>05</span>
              <p>Massive Liverpool FC supporter</p>
            </div>

            <div class="fact-card">
              <span>06</span>
              <p>Passionate about world travel</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section about-cta">
        <div class="container about-cta-inner">
          <div>
            <p class="eyebrow">Start Here</p>
            <h2>Ready to Discover Something Great?</h2>

            <p>
              Explore reactions, reviews, interviews, and anime conversations
              created for fans who want more from the stories they watch.
            </p>
          </div>

          <div class="hero-actions">
            <a
              class="button"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              Watch on YouTube
            </a>

            <a class="button button-secondary" href="/"> Return Home </a>
          </div>
        </div>
      </section>
    </Layout>
---
import Layout from "../layouts/layout.astro";

const socialLinks = {
  youtube: "https://www.youtube.com/@aburnsy",
  tiktok: "https://www.tiktok.com/@aburnsy",
  instagram: "https://www.instagram.com/aburnsy_/",
  snapchat: "https://www.snapchat.com/@aburnsy08",
  patreon: "https://www.patreon.com/Aburnsy",
  famousBirthdays: "https://www.famousbirthdays.com/people/aburnsy.html",
};
---

<Layout
  title="Contact Aburnsy | Press, Partnerships and Management"
  description="Contact the Aburnsy team for brand partnerships, press requests, interviews, convention appearances, speaking opportunities and general inquiries."
>

      <section class="contact-hero">
        <div class="container contact-hero-grid">
          <div>
            <p class="eyebrow">Contact Aburnsy</p>

            <h1>Let’s Start a Conversation.</h1>

            <p class="contact-hero-lead">
              For partnerships, press, interviews, appearances, and professional
              opportunities, contact the Aburnsy team using the address that
              best matches your request.
            </p>

            <p class="contact-hero-copy">
              Choosing the correct contact helps us respond more quickly and
              route your message to the right person.
            </p>
          </div>

          <div class="contact-hero-image">
            <img
              src="/images/burnsy-contact.jpg"
              alt="Professional portrait of Aburnsy"
            />
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Professional Inquiries</p>
            <h2>Choose the Right Contact.</h2>
            <p>
              Each address below is dedicated to a specific type of request.
            </p>
          </div>

          <div class="contact-option-grid">
            <a
              class="contact-option-card"
              href="mailto:manager@aburnsy.com"
            >
              <span class="contact-label">Management</span>
              <h3>manager@aburnsy.com</h3>

              <p>
                Convention bookings, speaking opportunities, appearances,
                scheduling, representation, and general professional inquiries.
              </p>

              <strong>Email Management →</strong>
            </a>

            <a
              class="contact-option-card"
              href="mailto:partnerships@aburnsy.com"
            >
              <span class="contact-label">Partnerships</span>
              <h3>partnerships@aburnsy.com</h3>

              <p>
                Sponsorships, campaigns, product collaborations, integrations,
                affiliate opportunities, and long-term brand partnerships.
              </p>

              <strong>Email Partnerships →</strong>
            </a>

            <a
              class="contact-option-card"
              href="mailto:press@aburnsy.com"
            >
              <span class="contact-label">Press</span>
              <h3>press@aburnsy.com</h3>

              <p>
                Interviews, media requests, podcast appearances, commentary,
                quotes, features, and press-related inquiries.
              </p>

              <strong>Email Press →</strong>
            </a>

            <a
              class="contact-option-card"
              href="mailto:burnsy@aburnsy.com"
            >
              <span class="contact-label">General</span>
              <h3>burnsy@aburnsy.com</h3>

              <p>
                General questions and inquiries that do not fit into the
                management, partnership, or press categories.
              </p>

              <strong>Send a General Email →</strong>
            </a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container response-grid">
          <div>
            <p class="eyebrow">Before You Reach Out</p>
            <h2>Helpful Information to Include.</h2>

            <p class="response-copy">
              Providing a few key details in your first message helps the team
              understand the opportunity and respond efficiently.
            </p>
          </div>

          <div class="response-list">
            <div>
              <span>01</span>
              <p>Your name, company, publication, or organization</p>
            </div>

            <div>
              <span>02</span>
              <p>A clear description of the opportunity or request</p>
            </div>

            <div>
              <span>03</span>
              <p>Relevant dates, deadlines, location, or campaign timing</p>
            </div>

            <div>
              <span>04</span>
              <p>Budget information when contacting us about paid work</p>
            </div>

            <div>
              <span>05</span>
              <p>The best way and time to contact you</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Follow Aburnsy</p>
            <h2>Connect Across the Community.</h2>
            <p>
              For videos, creator updates, behind-the-scenes content, and anime
              conversations, follow Aburnsy on your preferred platform.
            </p>
          </div>

          <div class="contact-social-grid">
            <a
              class="contact-social-card"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              <h3>YouTube</h3>
              <p>Reactions, reviews, interviews, and long-form content.</p>
              <span>Visit YouTube →</span>
            </a>

            <a
              class="contact-social-card"
              href={socialLinks.tiktok}
              target="_blank"
              rel="noreferrer"
            >
              <h3>TikTok</h3>
              <p>Anime recommendations, short-form videos, and quick takes.</p>
              <span>Visit TikTok →</span>
            </a>

            <a
              class="contact-social-card"
              href={socialLinks.instagram}
              target="_blank"
              rel="noreferrer"
            >
              <h3>Instagram</h3>
              <p>Creator updates, behind-the-scenes content, and highlights.</p>
              <span>Visit Instagram →</span>
            </a>

            <a
              class="contact-social-card"
              href={socialLinks.patreon}
              target="_blank"
              rel="noreferrer"
            >
              <h3>Patreon</h3>
              <p>Exclusive reactions, bonus content, and early access.</p>
              <span>Visit Patreon →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section contact-final-cta">
        <div class="container contact-final-inner">
          <div>
            <p class="eyebrow">Professional Opportunities</p>
            <h2>Interested in Working With Aburnsy?</h2>

            <p>
              Explore partnership formats, audience information, appearance
              opportunities, and media options on the Work With Burnsy page.
            </p>
          </div>

          <div class="hero-actions">
            <a class="button" href="/work-with-burnsy/">
              Work With Burnsy
            </a>

            <a class="button button-secondary" href="/">
              Return Home
            </a>
          </div>
        </div>
      </section>

    </Layout>
---
import Layout from "../layouts/layout.astro";

const socialLinks = {
  youtube: "https://www.youtube.com/@aburnsy",
  tiktok: "https://www.tiktok.com/@aburnsy",
  instagram: "https://www.instagram.com/aburnsy_/",
  patreon: "https://www.patreon.com/Aburnsy",
};
---

<Layout
  title="Watch | Anime Reactions, Reviews & Interviews | Aburnsy"
  description="Watch first-time anime reactions, reviews, interviews, and educational videos from Burnsy on YouTube."
>
      <section class="watch-hero">
        <div class="container watch-hero-grid">
          <div>
            <p class="eyebrow">Watch Aburnsy</p>

            <h1>Reactions, Reviews, Interviews, and Anime Conversations.</h1>

            <p class="watch-hero-lead">
              Explore first-time reactions, thoughtful reviews, creator
              interviews, and story-focused anime content from Burnsy.
            </p>

            <div class="hero-actions">
              <a
                class="button"
                href={socialLinks.youtube}
                target="_blank"
                rel="noreferrer"
              >
                Visit YouTube
              </a>

              <a class="button button-secondary" href="/">
                Return Home
              </a>
            </div>
          </div>

          <div class="watch-hero-image">
            <img
              src="/images/burnsy-watch.jpg"
              alt="Burnsy creating anime content"
            />
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Featured Series</p>
            <h2>Start With Burnsy’s Current Favorites.</h2>
            <p>
              These are the best places to begin if you’re new to the channel.
            </p>
          </div>

          <div class="watch-grid">
            <a
              class="watch-card"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              <span class="card-number">01</span>
              <h3>My Hero Academia</h3>
              <p>
                Follow Burnsy’s first-time journey through one of anime’s most
                recognizable hero stories.
              </p>
              <span class="card-link">Watch the Series →</span>
            </a>

            <a
              class="watch-card"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              <span class="card-number">02</span>
              <h3>One Piece</h3>
              <p>
                Reactions, discussions, and story analysis from one of anime’s
                biggest adventures.
              </p>
              <span class="card-link">Watch the Series →</span>
            </a>

            <a
              class="watch-card"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              <span class="card-number">03</span>
              <h3>Banana Fish</h3>
              <p>
                Thoughtful reactions and conversations about one of Burnsy’s
                favorite anime stories.
              </p>
              <span class="card-link">Explore Banana Fish →</span>
            </a>

            <a
              class="watch-card"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              <span class="card-number">04</span>
              <h3>Anime Classroom</h3>
              <p>
                Story-focused videos exploring characters, themes, and why
                great anime works.
              </p>
              <span class="card-link">Enter the Classroom →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">More From Burnsy</p>
            <h2>Choose How You Want to Watch.</h2>
          </div>

          <div class="watch-category-grid">
            <article class="watch-category-card">
              <h3>First-Time Reactions</h3>
              <p>
                Genuine reactions to major anime series, followed by discussion
                and analysis.
              </p>
            </article>

            <article class="watch-category-card">
              <h3>Reviews</h3>
              <p>
                Honest, spoiler-aware reviews designed to help fans decide what
                to watch next.
              </p>
            </article>

            <article class="watch-category-card">
              <h3>Interviews</h3>
              <p>
                Conversations with artists, musicians, creators, and people
                connected to anime and pop culture.
              </p>
            </article>
          </div>

          <div class="watch-page-cta">
            <a
              class="button"
              href={socialLinks.youtube}
              target="_blank"
              rel="noreferrer"
            >
              Browse All Videos on YouTube
            </a>
          </div>
        </div>
      </section>
    </Layout>
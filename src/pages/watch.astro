---
import Layout from "../layouts/layout.astro";

const links = {
  youtube: "https://www.youtube.com/@aburnsy",
  youtubeLatest:
    "https://www.youtube.com/playlist?list=PLXvgarzxz5v0",
  tiktok: "https://www.tiktok.com/@aburnsy",
  instagram: "https://www.instagram.com/aburnsy_/",
  recommendationTool:
    "https://aburnsy-what-to-watch-wizard.streamlit.app/",
};

const youtubeEmbed =
  "https://www.youtube.com/embed/videoseries?list=PLXvgarzxz5v0";
---

<Layout
  title="Watch | Latest Anime Content from Aburnsy"
  description="Watch Aburnsy's latest YouTube reactions, newest TikTok and Instagram content, and find your next anime with Burnsy's recommendation tool."
  image="/images/watch/one-piece.jpg"
>
  <section class="watch-hero">
    <div class="container watch-hero-grid">
      <div>
        <p class="eyebrow">Watch Aburnsy</p>

        <h1>Anime Reactions, Recommendations, and Conversations.</h1>

        <p class="watch-hero-lead">
          Catch Burnsy’s latest long-form reactions, discover new short-form
          anime content, and find the next story worth adding to your watchlist.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href="#latest-youtube"
          >
            Watch the Latest
          </a>

          <a
            class="button button-secondary"
            href={links.youtube}
            target="_blank"
            rel="noreferrer"
          >
            Visit YouTube
          </a>
        </div>
      </div>

      <div class="watch-hero-image">
        <img
          src="/images/burnsy-watch.jpg"
          alt="Burnsy creating anime content"
        />
      </div>
    </div>
  </section>

  <section class="section section-dark" id="latest-youtube">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Latest on YouTube</p>

        <h2>Watch Burnsy’s Newest Reaction.</h2>

      </div>

      <div class="latest-youtube-grid">
        <div class="latest-youtube-player">
          <iframe
            src={youtubeEmbed}
            title="Latest Aburnsy YouTube reaction"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <div class="latest-youtube-copy">
          <span class="social-embed-label">Latest Reaction</span>

          <h3>Start With the Newest Release.</h3>

          <p>
            For more of Burnsy’s reactions click the Open Playlist button below.
          </p>

          <a
            class="button"
            href={links.youtubeLatest}
            target="_blank"
            rel="noreferrer"
          >
            Open Playlist
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Latest Short-Form</p>

        <h2>Follow Burnsy on TikTok and Instagram.</h2>

        <p>
          Browse the newest anime takes, recommendations, creator updates, and
          short-form conversations directly from Burnsy’s social profiles.
        </p>
      </div>

      <div class="social-embed-grid">
        <article class="social-embed-card">
          <div class="social-embed-card-heading">
            <div>
              <span class="social-embed-label">TikTok</span>
              <h3>@aburnsy</h3>
            </div>

            <a
              href={links.tiktok}
              target="_blank"
              rel="noreferrer"
            >
              Open TikTok →
            </a>
          </div>

          <div class="social-embed-frame social-embed-frame-tiktok">
            <blockquote
              class="tiktok-embed"
              cite="https://www.tiktok.com/@aburnsy"
              data-unique-id="aburnsy"
              data-embed-type="creator"
              style="max-width: 780px; min-width: 288px;"
            >
              <section>
                <a
                  target="_blank"
                  href="https://www.tiktok.com/@aburnsy?refer=creator_embed"
                >
                  @aburnsy
                </a>
              </section>
            </blockquote>
          </div>
        </article>

        <article class="social-embed-card">
          <div class="social-embed-card-heading">
            <div>
              <span class="social-embed-label">Instagram</span>
              <h3>@aburnsy_</h3>
            </div>

            <a
              href={links.instagram}
              target="_blank"
              rel="noreferrer"
            >
              Open Instagram →
            </a>
          </div>

          <div class="social-embed-frame social-embed-frame-instagram">
            <blockquote
              class="instagram-media"
              data-instgrm-permalink="https://www.instagram.com/aburnsy_/?utm_source=ig_embed&amp;utm_campaign=loading"
              data-instgrm-version="14"
            >
              <a
                href="https://www.instagram.com/aburnsy_/"
                target="_blank"
              >
                View @aburnsy_ on Instagram
              </a>
            </blockquote>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section watch-recommendation-section">
    <div class="container watch-recommendation-grid">
      <div>
        <p class="eyebrow">Not Sure What to Watch?</p>

        <h2>Let Burnsy Help You Find Your Next Favorite Anime.</h2>

        <p>
          Choose your preferred genres, mood, episode length, streaming
          platforms, and more to get recommendations built around what you
          actually want to watch.
        </p>
      </div>

      <div class="watch-recommendation-card">
        <span class="watch-recommendation-status">
          Burnsy’s Recommendation Tool
        </span>

        <h3>Find Something Worth Watching.</h3>

        <p>
          Discover classics, current favorites, and hidden gems chosen around
          your personal preferences.
        </p>

        <a
          class="button"
          href={links.recommendationTool}
          target="_blank"
          rel="noreferrer"
        >
          Find My Next Anime
        </a>
      </div>
    </div>
  </section>

  <section class="section watch-final-cta">
    <div class="container watch-final-inner">
      <div>
        <p class="eyebrow">More From Burnsy</p>

        <h2>Continue the Conversation.</h2>

        <p>
          Subscribe on YouTube and follow Burnsy across social media for new
          reactions, reviews, interviews, and anime recommendations.
        </p>
      </div>

      <a
        class="button"
        href={links.youtube}
        target="_blank"
        rel="noreferrer"
      >
        Subscribe on YouTube
      </a>
    </div>
  </section>

  <script
    is:inline
    async
    src="https://www.tiktok.com/embed.js"
  ></script>

  <script
    is:inline
    async
    src="https://www.instagram.com/embed.js"
  ></script>
</Layout>
